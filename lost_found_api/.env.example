APP_ENV=local
APP_KEY=
APP_DEBUG=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null

SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Module Tinder Cards - analyse IA des correspondances.
SWIPE_AI_ENABLED=true
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
SWIPE_AI_MODEL=gpt-4o-mini
SWIPE_AI_TIMEOUT=12
SWIPE_AI_CACHE_TTL=3600
SWIPE_MAX_CANDIDATES=30

# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# E-mail ---------------------------------------------------------------------
# Développement : Mailpit (service docker-compose) capture tous les envois.
#   Interface + API : http://localhost:8025
# Production : un vrai serveur SMTP, par ex. Gmail (mot de passe d'application) :
#   MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_SCHEME=tls,
#   MAIL_USERNAME=votre-adresse@gmail.com, MAIL_PASSWORD=<mot de passe d'application>,
#   MAIL_FROM_ADDRESS=votre-adresse@gmail.com
# Ne jamais committer un vrai mot de passe : .env est ignore par Git.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@lostfound.local"
MAIL_FROM_NAME="${APP_NAME}"
# En développement, redirige tous les e-mails vers cette adresse (laisser vide
# pour livrer normalement). Utile pour tester avec une vraie boîte.
MAIL_DEMO_REDIRECT=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

APP_NAME="Lost&Found AI"
APP_URL=http://localhost:8000

# Google Sign-In : client OAuth Web (audience des ID tokens Google).
# Doit etre identique a GOOGLE_SERVER_CLIENT_ID dans l'application Flutter.
GOOGLE_CLIENT_ID=103241478877-9injf5juroq9an661l1fl5315g22edk8.apps.googleusercontent.com

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=lost_found
DB_USERNAME=lostfound
DB_PASSWORD=lostfound2026

SESSION_DRIVER=database
QUEUE_CONNECTION=sync
CACHE_STORE=database
